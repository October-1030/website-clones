{
  "name": "studypal-ai",
  "version": "0.9.0",
  "private": true,
  "description": "StudyPal AI local study workspace",
  "author": "StudyPal AI",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "node scripts/start-local.mjs",
    "local": "npm run build && npm run start:local",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e:p1": "node e2e/p1-study-flow.cjs",
    "test:e2e:p2": "node e2e/p2-study-flow.cjs",
    "test:e2e:p3": "node e2e/p3-homework-flow.cjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e:p4": "node e2e/p4-video-flow.cjs",
    "test:e2e:p5": "node e2e/p5-transcribe-flow.cjs",
    "test:e2e:final": "node e2e/final-study-suite.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "^16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
