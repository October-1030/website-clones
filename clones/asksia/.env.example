# Keep demo mode until a server-side model key and model name are configured.
STUDYPAL_AI_PROVIDER=demo

# China-region MiniMax Responses API. MINIMAX_MODEL defaults to MiniMax-M3.
# If STUDYPAL_AI_PROVIDER is omitted, the presence of MINIMAX_API_KEY selects MiniMax.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Optional OpenAI Responses API alternative.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Relative paths are resolved from the StudyPal AI project directory.
STUDYPAL_DATA_DIR=.studypal-data

# Preferred YouTube caption language. Falls back to the original/available track.
STUDYPAL_MEDIA_LANGUAGE=en

# Optional comma-separated podcast hosts that expose a structured JSON-LD transcript.
STUDYPAL_MEDIA_ALLOWED_HOSTS=

# Local Faster-Whisper speech-to-text. The model must already exist in the local cache.
STUDYPAL_TRANSCRIBE_MODEL=small
STUDYPAL_TRANSCRIBE_DEVICE=cpu
STUDYPAL_TRANSCRIBE_COMPUTE_TYPE=int8
STUDYPAL_TRANSCRIBE_LANGUAGE=
STUDYPAL_TRANSCRIBE_PYTHON=
STUDYPAL_TRANSCRIBE_TIMEOUT_MS=300000

# Optional StudyPal cloud account. Use a dedicated Supabase project.
# off: local only; optional: cloud when signed in, local otherwise; required: sign-in required.
STUDYPAL_CLOUD_MODE=optional
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LMS credentials are encrypted before they are stored in Supabase.
# Generate 32 random bytes and encode them as base64. Never commit the real value.
STUDYPAL_LMS_ENCRYPTION_KEY=

# Canvas accepts *.instructure.com by default. Add exact custom institutional hosts here.
STUDYPAL_LMS_ALLOWED_HOSTS=

# Optional Canvas OAuth. Manual read-only tokens remain available without these values.
CANVAS_INSTANCE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://127.0.0.1:3000/api/lms/canvas/oauth/callback
# Optional Blackboard Learn REST integration. The school administrator must install the
# application and assign a least-privilege read-only integration user.
BLACKBOARD_INSTANCE_URL=
BLACKBOARD_APP_KEY=
BLACKBOARD_APP_SECRET=
