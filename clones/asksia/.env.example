# Keep demo mode until a server-side model key and model name are configured.
STUDYPAL_AI_PROVIDER=demo

# Required only when STUDYPAL_AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Relative paths are resolved from the StudyPal AI project directory.
STUDYPAL_DATA_DIR=.studypal-data
